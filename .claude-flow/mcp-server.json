{
  "mcpServers": {
    "dolbomcare": {
      "command": "node",
      "args": ["mcp-server/index.js"],
      "env": {
        "DOLBOMCARE_API_URL": "http://localhost:8000/api/v1",
        "DOLBOMCARE_JWT_SECRET": "${SECRET_KEY}",
        "RUFLO_MCP_LOG": "debug"
      }
    }
  },

  "tools": {
    "dolbomcare/voice": {
      "create": {
        "description": "음성 기록 생성 (Whisper 변환 포함)",
        "schema": {
          "resident_id": "string",
          "audio_file": "binary",
          "service_type": "enum:basic_care|meal_service|medical_care|emergency",
          "notes": "string"
        }
      },
      "list": {
        "description": "음성 기록 조회 (필터링)",
        "schema": {
          "resident_id": "string?",
          "date_range": "object{start, end}?",
          "status": "enum:active|archived?"
        }
      },
      "archive": {
        "description": "음성 기록 아카이브",
        "schema": {
          "voice_id": "string"
        }
      }
    },

    "dolbomcare/billing": {
      "auto_create": {
        "description": "음성 기록으로부터 자동 청부 생성",
        "schema": {
          "voice_id": "string",
          "auto_approve": "boolean?",
          "override_amount": "number?"
        }
      },
      "approve": {
        "description": "청부 승인 (센터장)",
        "schema": {
          "billing_id": "string",
          "notes": "string?",
          "override_amount": "number?"
        }
      },
      "reject": {
        "description": "청부 거절",
        "schema": {
          "billing_id": "string",
          "reason": "string"
        }
      },
      "list": {
        "description": "청부 조회",
        "schema": {
          "status": "enum:draft|pending|approved|submitted_to_nhis|reimbursed?",
          "date_range": "object?",
          "caregiver_id": "string?"
        }
      }
    },

    "dolbomcare/residents": {
      "list": {
        "description": "이용자 목록 조회",
        "schema": {
          "center_id": "string?",
          "status": "enum:active|inactive?"
        }
      },
      "get": {
        "description": "이용자 상세 정보",
        "schema": {
          "resident_id": "string"
        }
      },
      "update": {
        "description": "이용자 정보 수정",
        "schema": {
          "resident_id": "string",
          "data": "object"
        }
      }
    },

    "dolbomcare/caregivers": {
      "list": {
        "description": "요양사 목록",
        "schema": {
          "center_id": "string",
          "status": "enum:active|inactive?"
        }
      },
      "get_performance": {
        "description": "요양사 성과 지표",
        "schema": {
          "caregiver_id": "string",
          "month": "string (YYYY-MM)?"
        }
      }
    },

    "dolbomcare/analytics": {
      "get_daily_summary": {
        "description": "일일 요약",
        "schema": {
          "date": "string (YYYY-MM-DD)?",
          "center_id": "string?"
        }
      },
      "get_monthly_report": {
        "description": "월간 리포트 생성",
        "schema": {
          "month": "string (YYYY-MM)",
          "include": "array:billing|voice|residents?"
        }
      },
      "detect_anomalies": {
        "description": "이상 감지",
        "schema": {
          "data_type": "enum:billing|voice|attendance",
          "threshold": "number (0-1)?"
        }
      }
    },

    "dolbomcare/notifications": {
      "send_push": {
        "description": "푸시 알림 전송",
        "schema": {
          "user_id": "string",
          "title": "string",
          "body": "string",
          "data": "object?"
        }
      },
      "send_email": {
        "description": "이메일 발송",
        "schema": {
          "to": "string",
          "subject": "string",
          "template": "enum:daily_summary|billing_notification|emergency_alert",
          "variables": "object?"
        }
      }
    }
  },

  "hooks": {
    "pre_tool_use": [
      {
        "id": "dolbomcare-auth",
        "description": "dolbomcare API 인증 토큰 자동 첨부",
        "tools": ["dolbomcare/*"],
        "action": "attach_jwt_token"
      },
      {
        "id": "billing-validation",
        "description": "청부 생성 전 검증",
        "tools": ["dolbomcare/billing/auto_create"],
        "action": "validate_voice_record"
      }
    ],

    "post_tool_use": [
      {
        "id": "voice-to-billing",
        "description": "음성 기록 생성 후 자동 청부 생성",
        "tools": ["dolbomcare/voice/create"],
        "action": "trigger_billing_creation",
        "trigger_condition": "success"
      },
      {
        "id": "billing-approval-log",
        "description": "청부 승인 로깅 및 메모리 학습",
        "tools": ["dolbomcare/billing/approve"],
        "action": "log_and_learn",
        "memory_pattern": "billing_approval_rules"
      }
    ]
  }
}
